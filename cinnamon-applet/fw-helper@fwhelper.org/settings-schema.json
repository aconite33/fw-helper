{
    "head-graphs": {
        "type": "header",
        "description": "Graphs"
    },
    "show-cpu": {
        "type": "checkbox",
        "default": true,
        "description": "CPU load  (sparkline)"
    },
    "show-mem": {
        "type": "checkbox",
        "default": true,
        "description": "Memory usage  (sparkline)"
    },
    "show-disk": {
        "type": "checkbox",
        "default": true,
        "description": "Disk usage  (bar)",
        "tooltip": "A bar rather than a graph: disk usage barely moves, so its history carries nothing."
    },
    "graph-width": {
        "type": "spinbutton",
        "default": 42,
        "min": 16,
        "max": 160,
        "step": 2,
        "units": "pixels",
        "description": "Sparkline width",
        "tooltip": "One sample per pixel, so this is also how much history is kept."
    },
    "disk-path": {
        "type": "entry",
        "default": "/",
        "description": "Filesystem to report",
        "tooltip": "Any path on the filesystem you want measured, for example /home"
    },
    "head-text": {
        "type": "header",
        "description": "Text readouts"
    },
    "show-temp": {
        "type": "checkbox",
        "default": true,
        "description": "CPU temperature"
    },
    "show-battery": {
        "type": "checkbox",
        "default": true,
        "description": "Battery percentage",
        "tooltip": "A leading + means charging."
    },
    "show-fan": {
        "type": "checkbox",
        "default": true,
        "description": "Fan speed"
    },
    "show-power": {
        "type": "checkbox",
        "default": true,
        "description": "Power draw",
        "tooltip": "Only shown while on battery. Nothing reports whole-machine draw on mains."
    },
    "compact": {
        "type": "checkbox",
        "default": true,
        "description": "Compact text",
        "tooltip": "52° · 2.1k · 15W · 30%   instead of the long form"
    },
    "head-display": {
        "type": "header",
        "description": "Other"
    },
    "show-icon": {
        "type": "checkbox",
        "default": false,
        "description": "Show the icon",
        "tooltip": "The icon costs more panel width than any single reading."
    },
    "interval": {
        "type": "spinbutton",
        "default": 2,
        "min": 1,
        "max": 30,
        "step": 1,
        "units": "seconds",
        "description": "Refresh every"
    }
}
