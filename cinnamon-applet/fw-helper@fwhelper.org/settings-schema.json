{
    "head-graphs": {
        "type": "header",
        "description": "Graphs"
    },
    "show-cpu": {
        "type": "checkbox",
        "default": true,
        "description": "CPU load  (sparkline)"
    },
    "show-mem": {
        "type": "checkbox",
        "default": true,
        "description": "Memory usage  (sparkline)"
    },
    "show-cores": {
        "type": "checkbox",
        "default": false,
        "description": "Per-core bars",
        "tooltip": "One column per core. Shows four cores pinned while eight idle, which a single average hides."
    },
    "show-disk": {
        "type": "checkbox",
        "default": true,
        "description": "Disk usage  (bars)",
        "tooltip": "One bar per mounted drive, detected automatically - a VeraCrypt or USB volume appears when mounted and vanishes when closed."
    },
    "disk-bar-width": {
        "type": "spinbutton",
        "default": 14,
        "min": 6,
        "max": 40,
        "step": 1,
        "units": "pixels",
        "description": "Disk bar width",
        "tooltip": "Colour runs green when empty to purple when full."
    },
    "graph-width": {
        "type": "spinbutton",
        "default": 42,
        "min": 16,
        "max": 160,
        "step": 2,
        "units": "pixels",
        "description": "Sparkline width",
        "tooltip": "One sample per pixel, so this is also how much history is kept."
    },
    "head-text": {
        "type": "header",
        "description": "Text readouts"
    },
    "show-temp": {
        "type": "checkbox",
        "default": true,
        "description": "CPU temperature"
    },
    "show-battery": {
        "type": "checkbox",
        "default": true,
        "description": "Battery",
        "tooltip": "Drawn as a battery with the percentage inside it. A bolt appears beside it while charging."
    },
    "battery-width": {
        "type": "spinbutton",
        "default": 35,
        "min": 20,
        "max": 70,
        "step": 1,
        "units": "pixels",
        "description": "Battery width",
        "tooltip": "Height, the digits inside it and the charging bolt all scale with this."
    },
    "show-fan": {
        "type": "checkbox",
        "default": true,
        "description": "Fan speed"
    },
    "show-power": {
        "type": "checkbox",
        "default": true,
        "description": "Power draw",
        "tooltip": "Only shown while on battery. Nothing reports whole-machine draw on mains."
    },
    "compact": {
        "type": "checkbox",
        "default": true,
        "description": "Compact text",
        "tooltip": "52\u00b0  2.1k  15W   instead of the long form"
    },
    "head-display": {
        "type": "header",
        "description": "Other"
    },
    "proc-count": {
        "type": "spinbutton",
        "default": 5,
        "min": 1,
        "max": 12,
        "step": 1,
        "units": "processes",
        "description": "Top processes listed",
        "tooltip": "Only gathered while the dropdown is open - walking every process is the costly reading here."
    },
    "show-icon": {
        "type": "checkbox",
        "default": false,
        "description": "Show the icon",
        "tooltip": "The icon costs more panel width than any single reading."
    },
    "interval": {
        "type": "spinbutton",
        "default": 2,
        "min": 1,
        "max": 30,
        "step": 1,
        "units": "seconds",
        "description": "Refresh every"
    }
}
