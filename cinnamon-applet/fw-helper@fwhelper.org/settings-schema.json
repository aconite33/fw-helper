{
    "head-display": {
        "type": "header",
        "description": "Panel display"
    },
    "show-temp": {
        "type": "checkbox",
        "default": true,
        "description": "CPU temperature"
    },
    "show-fan": {
        "type": "checkbox",
        "default": true,
        "description": "Fan speed"
    },
    "show-power": {
        "type": "checkbox",
        "default": true,
        "description": "Power draw",
        "tooltip": "Only shown while on battery. Nothing reports whole-machine draw on mains."
    },
    "head-update": {
        "type": "header",
        "description": "Updates"
    },
    "interval": {
        "type": "spinbutton",
        "default": 2,
        "min": 1,
        "max": 30,
        "step": 1,
        "units": "seconds",
        "description": "Refresh every"
    }
}
