{
    "head-display": {
        "type": "header",
        "description": "Panel display"
    },
    "compact": {
        "type": "checkbox",
        "default": true,
        "description": "Compact readout",
        "tooltip": "52° · 2.1k · 18W  instead of  52°C  2150 rpm  18.3 W"
    },
    "show-icon": {
        "type": "checkbox",
        "default": false,
        "description": "Show the icon",
        "tooltip": "The icon costs more panel width than any single reading."
    },
    "show-temp": {
        "type": "checkbox",
        "default": true,
        "description": "CPU temperature"
    },
    "show-fan": {
        "type": "checkbox",
        "default": true,
        "description": "Fan speed"
    },
    "show-power": {
        "type": "checkbox",
        "default": true,
        "description": "Power draw",
        "tooltip": "Only shown while on battery. Nothing reports whole-machine draw on mains."
    },
    "head-update": {
        "type": "header",
        "description": "Updates"
    },
    "interval": {
        "type": "spinbutton",
        "default": 2,
        "min": 1,
        "max": 30,
        "step": 1,
        "units": "seconds",
        "description": "Refresh every"
    }
}
