#!/bin/sh
# Opt in to battery charge limiting.
#
# Deliberately a separate command rather than something the package does on install:
# it decides which mechanism governs charging on this machine. Framework's EC
# implements a custom charge-control command alongside the standard one, and the
# custom one can override the standard one - which is why the kernel driver declines
# to bind here unless told otherwise. See ADR 0008.
set -eu
[ "$(id -u)" = 0 ] || { echo "run this with sudo" >&2; exit 1; }

echo "This makes fw-helper the battery charge-limit authority on this machine."
echo "Leave the battery limit in UEFI setup at its default, or the two will fight."
echo

install -m 644 /usr/share/fw-helper/fw-helper.modprobe.conf \
    /etc/modprobe.d/fw-helper.conf
modprobe -r cros_charge_control 2>/dev/null || true
modprobe cros_charge_control 2>/dev/null || true
sleep 1

if [ -e /sys/class/power_supply/BAT1/charge_control_end_threshold ]; then
    echo "OK: charge control is available."
    echo "    current limit: $(cat /sys/class/power_supply/BAT1/charge_control_end_threshold)%"
    echo "    set one with:  fw-helperctl charge-limit 80"
else
    echo "Not available yet. A reboot may be needed; check: dmesg | grep -i charge" >&2
    exit 1
fi
